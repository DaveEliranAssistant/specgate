{
  "name": "@qe-atlas/specgate",
  "version": "0.1.0-rc.3",
  "private": false,
  "type": "module",
  "description": "Local code-first Express change review gate. No OpenAPI required.",
  "bin": {
    "specgate": "bin/specgate.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:runtime": "node --test test/runtime.test.mjs"
  },
  "bundleDependencies": [
    "acorn"
  ],
  "dependencies": {
    "acorn": "8.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaveEliranAssistant/specgate.git",
    "directory": "packages/specgate"
  },
  "homepage": "https://specgate-qe-atlas.vercel.app",
  "bugs": {
    "url": "https://github.com/DaveEliranAssistant/specgate/issues"
  },
  "keywords": [
    "express",
    "testing",
    "source-review"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
